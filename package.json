{
  "name": "sanction-app",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && node scripts/migrate-deploy.mjs && next build",
    "build:mcp": "npx esbuild mcp-server.ts --bundle --platform=node --outfile=packages/sanction-mcp/mcp-server.js --format=esm --external:@prisma/client --external:@prisma/adapter-pg --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "start": "next start",
    "lint": "eslint",
    "check": "tsc --noEmit && eslint && vitest run",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "RUN_DB_TESTS=1 vitest run tests/*.db.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1156.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/mcp": "1.7.12",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "nanoid": "^5.1.11",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "proxy-addr": "^2.0.8",
    "body-parser": "^2.4.0",
    "qs": "^6.17.0",
    "hono": "^4.13.14",
    "ip-address": "^10.7.5",
    "fast-uri": "^3.1.9",
    "source-map-js": "^1.2.2",
    "@hono/node-server": "^2.1.3"
  }
}
